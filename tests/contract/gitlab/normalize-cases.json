[
  {"name": "scalars", "input": {"s": "x", "i": 1, "n": 1.5, "b": true, "z": null},
   "expect": {"t": ["object"], "keys": {"b": {"t": ["boolean"]}, "i": {"t": ["integer"]}, "n": {"t": ["number"]}, "s": {"t": ["string"]}, "z": {"t": ["null"]}}}},
  {"name": "boolean is not integer", "input": [true, 1],
   "expect": {"t": ["array"], "items": {"t": ["boolean", "integer"]}}},
  {"name": "datetime string", "input": {"at": "2026-01-02T03:04:05.678Z", "day": "2026-01-02", "off": "2026-01-02T03:04:05+09:00"},
   "expect": {"t": ["object"], "keys": {"at": {"t": ["datetime"]}, "day": {"t": ["string"]}, "off": {"t": ["datetime"]}}}},
  {"name": "key order is ignored", "input": {"b": 1, "a": 2},
   "expect": {"t": ["object"], "keys": {"a": {"t": ["integer"]}, "b": {"t": ["integer"]}}}},
  {"name": "environment keys are dropped", "input": {"id": 1, "avatar_url": "x", "web_url": "x", "username": "u", "email": "e", "token": "t", "author": {"username": "u", "id": 2}},
   "expect": {"t": ["object"], "keys": {"author": {"t": ["object"], "keys": {"id": {"t": ["integer"]}}}, "id": {"t": ["integer"]}}}},
  {"name": "array element union with always and optional keys", "input": [{"a": 1, "b": 2}, {"a": 3}],
   "expect": {"t": ["array"], "items": {"t": ["object"], "keys": {"a": {"t": ["integer"]}, "b": {"t": ["integer"]}}, "opt": ["b"]}}},
  {"name": "null is not absent", "input": [{"a": 1}, {"a": null}],
   "expect": {"t": ["array"], "items": {"t": ["object"], "keys": {"a": {"t": ["integer", "null"]}}}}},
  {"name": "absent is not null", "input": [{"a": 1}, {}],
   "expect": {"t": ["array"], "items": {"t": ["object"], "keys": {"a": {"t": ["integer"]}}, "opt": ["a"]}}},
  {"name": "object and null in the same place", "input": [{"p": {"x": 1}}, {"p": null}],
   "expect": {"t": ["array"], "items": {"t": ["object"], "keys": {"p": {"t": ["null", "object"], "keys": {"x": {"t": ["integer"]}}}}}}},
  {"name": "empty array has no items", "input": {"a": []},
   "expect": {"t": ["object"], "keys": {"a": {"t": ["array"]}}}},
  {"name": "empty object", "input": {"a": {}},
   "expect": {"t": ["object"], "keys": {"a": {"t": ["object"], "keys": {}}}}},
  {"name": "empty array merged with filled array", "input": [[], [1]],
   "expect": {"t": ["array"], "items": {"t": ["array"], "items": {"t": ["integer"]}}}},
  {"name": "nested arrays merge", "input": {"l": [[1], [2.5]]},
   "expect": {"t": ["object"], "keys": {"l": {"t": ["array"], "items": {"t": ["array"], "items": {"t": ["integer", "number"]}}}}}},
  {"name": "depth is cut at 5", "input": {"a": {"b": {"c": {"d": {"e": {"f": 1}}}}}},
   "expect": {"t": ["object"], "keys": {"a": {"t": ["object"], "keys": {"b": {"t": ["object"], "keys": {"c": {"t": ["object"], "keys": {"d": {"t": ["object"], "keys": {"e": {"t": ["object"]}}}}}}}}}}}},
  {"name": "depth cut for arrays", "input": [[[[[[1]]]]]],
   "expect": {"t": ["array"], "items": {"t": ["array"], "items": {"t": ["array"], "items": {"t": ["array"], "items": {"t": ["array"], "items": {"t": ["array"]}}}}}}}
]
