{
  "version": 1,
  "note": "書き方は .agents/docs/gitlab-contract.md。パスは /api/v4 より後ろ。${名前} は録る側・比べる側が実体に置き換える。書き込みは最後にまとめてある（読みの形が前の書き込みで変わらないように）。expect_status は録るときに本物が返すべきステータス。reads はその応答のうち sh と拡張が読むキー（環境で変わる欄 web_url・username などは形から落とすので載せない）",
  "requests": [
    {"name": "user", "method": "GET", "path": "/user", "token": "main", "used_by": ["sh", "chrome"], "expect_status": 200, "reads": ["id"], "save": {"user.id": "id"}},
    {"name": "project", "method": "GET", "path": "/projects/${project}", "token": "main", "used_by": ["sh", "chrome"], "expect_status": 200, "reads": ["id", "default_branch", "archived", "issues_enabled", "issues_access_level", "permissions.project_access.access_level"]},
    {"name": "member", "method": "GET", "path": "/projects/${project}/members/all/${user.id}", "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["access_level"]},
    {"name": "mrs_opened", "method": "GET", "path": "/projects/${project}/merge_requests", "query": {"state": "opened", "source_branch": "${mr.branch}"}, "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["[].iid", "[].source_branch", "[].target_branch", "[].source_project_id", "[].state", "[].title", "[].description", "[].draft"]},
    {"name": "mrs_merged", "method": "GET", "path": "/projects/${project}/merge_requests", "query": {"state": "merged", "source_branch": "${mr.merged_branch}"}, "token": "main", "used_by": ["sh", "chrome"], "expect_status": 200, "reads": ["[].iid", "[].sha", "[].source_branch", "[].source_project_id", "[].state"]},
    {"name": "mr_get", "method": "GET", "path": "/projects/${project}/merge_requests/${mr.iid}", "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["iid", "source_branch", "target_branch", "source_project_id", "state", "title", "draft"]},
    {"name": "discussions", "method": "GET", "path": "/projects/${project}/merge_requests/${mr.iid}/discussions", "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["[].id", "[].notes", "[].notes[].id", "[].notes[].body", "[].notes[].created_at", "[].notes[].author.id", "[].notes[].system", "[].notes[].resolvable", "[].notes[].resolved", "[].notes[].type"]},
    {"name": "reviewers", "method": "GET", "path": "/projects/${project}/merge_requests/${mr.iid}/reviewers", "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["[].state", "[].created_at", "[].user.id"]},
    {"name": "approvals_get", "method": "GET", "path": "/projects/${project}/merge_requests/${mr.iid}/approvals", "token": "main", "used_by": ["scenarios"], "expect_status": 200, "reads": ["approved", "approved_by"]},
    {"name": "notes_get", "method": "GET", "path": "/projects/${project}/merge_requests/${mr.iid}/notes", "query": {"order_by": "created_at", "sort": "desc"}, "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["[].id", "[].body", "[].created_at", "[].author.id"]},
    {"name": "closes_issues", "method": "GET", "path": "/projects/${project}/merge_requests/${mr.iid}/closes_issues", "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["[].iid"]},
    {"name": "issues_list", "method": "GET", "path": "/projects/${project}/issues", "query": {"state": "opened"}, "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["[].iid", "[].title", "[].description", "[].author.id"]},
    {"name": "issue_get", "method": "GET", "path": "/projects/${project}/issues/${issue.iid}", "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["iid", "title", "state"]},
    {"name": "issue_notes_get", "method": "GET", "path": "/projects/${project}/issues/${issue.iid}/notes", "query": {"order_by": "created_at", "sort": "desc"}, "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["[].id", "[].body", "[].author.id"]},
    {"name": "issue_related_mrs", "method": "GET", "path": "/projects/${project}/issues/${issue.iid}/related_merge_requests", "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["[].iid", "[].source_branch", "[].target_branch", "[].source_project_id", "[].state", "[].title"]},
    {"name": "error_401", "method": "GET", "path": "/user", "token": "none", "used_by": ["sh", "chrome"], "expect_status": 401, "reads": ["message"]},
    {"name": "error_404", "method": "GET", "path": "/projects/${project}/merge_requests/999999", "token": "main", "used_by": ["sh", "chrome"], "expect_status": 404, "reads": ["message"]},
    {"name": "mr_put", "method": "PUT", "path": "/projects/${project}/merge_requests/${mr.iid}", "body": {"title": "contract: retitled"}, "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["iid", "title", "draft"]},
    {"name": "discussion_reply", "method": "POST", "path": "/projects/${project}/merge_requests/${mr.iid}/discussions/${discussion.id}/notes", "body": {"body": "contract reply"}, "token": "main", "used_by": ["sh"], "expect_status": 201, "reads": ["id"]},
    {"name": "discussion_resolve", "method": "PUT", "path": "/projects/${project}/merge_requests/${mr.iid}/discussions/${discussion.id}", "body": {"resolved": true}, "token": "main", "used_by": ["sh"], "expect_status": 200, "reads": ["id", "notes", "notes[].system", "notes[].resolvable", "notes[].resolved"]},
    {"name": "notes_post", "method": "POST", "path": "/projects/${project}/merge_requests/${mr.iid}/notes", "body": {"body": "contract note"}, "token": "main", "used_by": ["sh"], "expect_status": 201, "reads": ["id", "created_at", "author.id"]},
    {"name": "issue_create", "method": "POST", "path": "/projects/${project}/issues", "body": {"title": "contract issue", "description": "contract body"}, "token": "main", "used_by": ["sh"], "expect_status": 201, "reads": ["iid"]},
    {"name": "issue_notes_post", "method": "POST", "path": "/projects/${project}/issues/${issue.iid}/notes", "body": {"body": "contract issue note"}, "token": "main", "used_by": ["sh"], "expect_status": 201, "reads": ["id"]},
    {"name": "mr_create", "method": "POST", "path": "/projects/${project}/merge_requests", "body": {"source_branch": "${mr.new_branch}", "target_branch": "main", "title": "Draft: contract", "description": "Closes #${issue.iid}"}, "token": "main", "used_by": ["sh", "chrome"], "expect_status": 201, "reads": ["iid"]}
  ]
}
