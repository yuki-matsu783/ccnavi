{
  "name": "ccnavi-board",
  "displayName": "ccnavi ボード",
  "description": "ccnavi のチケット（提案・写し・印・作業ツリー）をカンバンで表示し、人の承認をターミナルへ送る。ルールと hook を画面で眺め、ルールを直し、判定を試す。projects/ のプロジェクトを一覧し、clone をターミナルへ送る",
  "version": "0.3.3",
  "publisher": "local",
  "private": true,
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Visualization"],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "ccnavi", "title": "ccnavi", "icon": "media/icon.svg" }
      ]
    },
    "views": {
      "ccnavi": [
        { "id": "ccnaviBoard.entries", "name": "画面", "icon": "media/icon.svg" }
      ]
    },
    "commands": [
      { "command": "ccnaviBoard.open", "title": "ccnavi ボード: ボードを開く" },
      { "command": "ccnaviBoard.refresh", "title": "ccnavi ボード: ボードを更新" },
      { "command": "ccnaviBoard.approve", "title": "ccnavi ボード: 承認待ちを承認する（--approve）" },
      { "command": "ccnaviBoard.openRules", "title": "ccnavi ボード: ルール設定画面を開く" },
      { "command": "ccnaviBoard.openProjects", "title": "ccnavi ボード: プロジェクト管理を開く" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "ccnaviBoard.open", "when": "ccnaviBoard.ticketControl == 'enable'" },
        { "command": "ccnaviBoard.refresh", "when": "ccnaviBoard.ticketControl == 'enable'" },
        { "command": "ccnaviBoard.approve", "when": "ccnaviBoard.ticketControl == 'enable'" }
      ]
    },
    "configuration": {
      "title": "ccnavi ボード",
      "properties": {
        "ccnaviBoard.binPath": {
          "type": "string",
          "default": "",
          "description": "ccnavi の実行ファイル。空なら .claude/settings.json の CCNAVI_BIN_PATH、次に dist/ccnavi/ccnavi、それも無ければ uv run python -m ccnavi の順に探す。ワークスペースルートからの相対でも絶対でもよい。"
        },
        "ccnaviBoard.bashPath": {
          "type": "string",
          "default": "",
          "description": "承認コマンドを送るターミナルのシェル（Windows だけ使う）。空なら Git Bash（C:\\Program Files\\Git\\bin\\bash.exe）、無ければ PATH の bash。"
        },
        "ccnaviBoard.samplesPath": {
          "type": "string",
          "default": ".claude/ccnavi/rule-samples.yml",
          "description": "ルール設定画面が一括で判定するサンプル（deny / ask / allow のタイプに tool と subject を並べた YAML）。ワークスペースルートからの相対でも絶対でもよい。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p . && node scripts/bundle.js",
    "test": "tsc -p . && node --test out/test/*.test.js",
    "package": "sh scripts/package.sh",
    "clean": "node scripts/clean.js"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
