{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "sourceMap": false,
    "declaration": false,
    "resolveJsonModule": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
