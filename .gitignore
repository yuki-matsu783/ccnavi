# Windows will not overwrite a running executable.
/ccnavi
/ccnavi.exe
/ccnavi.new.exe
/ccnavi.old.exe
/dist/

# Decision records written at runtime. They hold absolute paths and full
# command lines, so they never get committed.
/logs/
*.jsonl
