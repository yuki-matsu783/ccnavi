# 参照専用の資料。配布物には入らない。
knowledge

# 組み立ての出力。dist は hook が指す実行ファイルの置き場、
# build は PyInstaller の作業場所。
/dist/
/build/

# Python の中間物。
__pycache__/
*.py[cod]
.venv/
.ruff_cache/

# 実行時に書かれる記録。絶対パスとコマンド全文が入るのでコミットしない。
/logs/
*.jsonl

# hook がセッションごとに持つ一時的な状態。差し戻しの回数と、そのターンで
# 触ったツリーの一覧。他人に配ると「誰かの直しかけ」を持ち込むことになる。
/.claude/ccnavi/session/

# 実行後の監視がセッションごとに持つ控え。すでに伝えた変更を覚えているだけの
# 一時的な状態で、消えても次の起動で取り直せる。加えて、ここを追跡させると
# 監視が自分の控えを保護領域の変更として報告しはじめる。
/.claude/ccnavi/state/

# 並行セッションのワークツリー。ワークスペースルートの中に置かれるので、
# セッションの道具と権限が届く代わりに git の邪魔になる。
/.claude/worktrees/

# 承認済みのチケットの写しとフェーズの印。人がこの機械で承認した記録で、
# 他人に配るものではない。作業ツリーの側に同じ場所があっても読まない。
/.claude/ccnavi/tickets/

# ccnavi が自分のソースツリーでだけ読む上書き設定。
# 1 人がモードを変えて試すためのものなので、他人に届いてはいけない。
/ccnavi.settings.local.json

# 参照専用の他プロジェクト。中に .claude/ を持つので、リポジトリの中に置くと
# Claude Code がそこのスキルを読み込み、cd 1 回で別の根に見える。
# 読み終えたら外へ出す。置いている間だけ無視する。
/参考/
