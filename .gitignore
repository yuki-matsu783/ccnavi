# 参照専用の資料。配布物には入らない。
knowledge

# 組み立ての出力。dist は PyInstaller の出力、build はその作業場所。
# .ccnavi/bin は build.py が dist から写す、hook が起動する実行ファイルの置き場で、
# 機械ごとに <os>-<arch>/ が並ぶ。振り分けの sh は .ccnavi/scripts/ にあり、
# そちらは追跡する。
/dist/
/build/
/.ccnavi/bin/

# Python の中間物。
__pycache__/
*.py[cod]
.venv/
.ruff_cache/

# 実行時に書かれる記録。絶対パスとコマンド全文が入るのでコミットしない。
# 判定の記録（logs/decisions.jsonl）、git のラッパースクリプトの記録のほか、次の 3 つもここに入る。
#
#   logs/state/    実行後チェックがセッションごとに持つ記録。すでに伝えた変更を覚えて
#                  いるだけの一時的な状態で、消えても次の起動で取り直せる。追跡させると
#                  実行後チェックが自分の記録を保護領域の変更として報告しはじめる
#   logs/session/  hook がセッションごとに持つ一時的な状態。差し戻しの回数と、その
#                  ターンで触ったツリーの一覧。他人に配ると「誰かの直しかけ」を持ち込む
#   logs/diag/     sh・実行ファイル・拡張の診断ログ（docs/claude/logging.md）。あとから
#                  何が起きたかを追うための補助で、判定は読まない
/logs/

# md の frontmatter の索引（`ccnavi --docs`、SessionStart が書く）。
# ccnavi は git がここを無視しているときだけ書くので、ここで無視する。
# 旧版の `events/*.jsonl` は追跡するので、`*.jsonl` 全体は無視しない。
**/ccnavi-index.jsonl

# 途中を見せない書き方（一時ファイルに書いて差し替える。fsio.write_*_atomic / write_*_durable）が、
# 途中で落ちて残した一時ファイル。名前は `.<名前>.<一意>.part` か `.<名前>.<一意>.part<拡張子>`。
# 承認済みの置き場の外（wip/proposals/todo/ など）に残ったものを、通常のコミットに入れない。
.*.part
.*.part.*

# 並行セッションのワークツリー。ワークスペースルートの中に置かれるので、
# セッションの道具と権限が届く代わりに git の邪魔になる。
/.claude/worktrees/

# 承認済みチケットとフェーズのマーカーは ccnavi ディレクトリの下（`.ccnavi/tickets/`）に移り、git で追跡する。
# A が承認して B の機械で作業する流れを成り立たせるため（設計 9.2）。無視しない。

# ccnavi のプロジェクト置き場。各プロジェクトは自分の git を持つ（設計 11）。
# 入っていないと --lint が warn で言う。
/projects/

# ccnavi が自分のソースツリーでだけ読む上書き設定。
# 1 人がモードを変えて試すためのものなので、他人に届いてはいけない。
/ccnavi.settings.local.json

settings.local.json*

# 参照専用の他プロジェクト。.claude/ を持つ外部リポジトリは、--root なしの端末の
# ccnavi が根を取り違える（洗い出しは docs/design/multi-repo/standalone-clone-gaps.md の A2）ので、
# 読み終えたら外へ出す。置いている間だけ無視する。
/参考/

# 使い捨ての置き場。ワークスペースルート直下の scratchpad/ に、直接作業の途中でユーザに見せる
# 一時的な物や、コミットしたくない物を置く。ユーザに渡す物（wip/handoff/）と違い追跡も push もしない。
/scratchpad
