# 参照専用の資料。配布物には入らない。
knowledge

# 組み立ての出力。dist は hook が指す実行ファイルの置き場、
# build は PyInstaller の作業場所。
/dist/
/build/

# Python の中間物。
__pycache__/
*.py[cod]
.venv/
.ruff_cache/

# 実行時に書かれる記録。絶対パスとコマンド全文が入るのでコミットしない。
/logs/
*.jsonl

# Stop の hook が数えている差し戻しの回数。セッションごとの一時的な状態で、
# 他人に配ると「誰かの直しかけ」を持ち込むことになる。
/.claude/ccnavi/stop-retries/

# 並行セッションのワークツリー。プロジェクト根の中に置かれるので、
# セッションの道具と権限が届く代わりに git の邪魔になる。
/.claude/worktrees/

# ccnavi が自分のソースツリーでだけ読む上書き設定。
# 1 人がモードを変えて試すためのものなので、他人に届いてはいけない。
/ccnavi.settings.local.json
