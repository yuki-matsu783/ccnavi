{
  // Node で回す部品（src/core）と試験を out/ に出す。ビルドの manifest の組み立てと試験が読む。
  // 設定画面（src/options/）とボード（src/board/）の React も、jsdom で描く単体の試験のために出す
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "outDir": "out",
    "rootDir": ".",
    "skipLibCheck": true,
    "sourceMap": false,
    "jsx": "react-jsx"
  },
  "include": ["src/core/**/*.ts", "src/options/**/*.ts", "src/options/**/*.tsx", "src/board/**/*.ts", "src/board/**/*.tsx", "src/types/**/*.d.ts", "test/**/*.ts"]
}
