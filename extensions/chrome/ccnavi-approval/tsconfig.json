{
  // 画面・Worker・service worker の型を見るだけ（JS は esbuild が出す）。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // 設定画面（src/options/）とボード（src/board/）は React。JSX は esbuild が automatic で変換する
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
